# --- Database ---
DATABASE_URL=postgresql+asyncpg://cabinet_user:cabinet_pass@localhost:5432/cabinet_inventory
DATABASE_URL_SYNC=postgresql+psycopg2://cabinet_user:cabinet_pass@localhost:5432/cabinet_inventory

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=random-secret-for-webhook-url
# Supergroup or group chat ID for coordinator alerts (use /whereami to find it)
TELEGRAM_COORDINATOR_CHAT_ID=-100xxxxxxxxxx
# Optional: route coordinator alerts (checkouts, returns, requests, low-stock, etc.) into a
# specific forum topic instead of General. Run /whereami inside the "Inventory" topic to get
# the message_thread_id, then paste it here. Leave blank to post to General.
TELEGRAM_COORDINATOR_THREAD_ID=
# JSON mapping of group name to message_thread_id for forum/topic routing.
# Run /whereami inside each topic to get the message_thread_id values.
# Leave blank to send all coordinator alerts to the main chat without a topic.
TELEGRAM_GROUP_TOPIC_THREAD_IDS={"SHISHU_MANDAL":12,"GROUP_1":34,"GROUP_2":56,"GROUP_3":78}

# --- App ---
APP_NAME=Cabinet Inventory
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Reserved for upcoming scheduled reminder jobs. Not yet wired into the scheduler.
APP_TIMEZONE=America/Chicago

# --- Sentry (optional, leave blank to disable) ---
SENTRY_DSN=

# --- Internal job auth ---
# Shared secret used by GitHub Actions cron → POST /api/internal/jobs/* endpoints.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be set in BOTH Render environment variables AND GitHub Actions secrets (CRON_SECRET).
CRON_SECRET=change-me-to-a-long-random-string
